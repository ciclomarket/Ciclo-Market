# Server environment (Render / Node)
# Copy to server/.env for local dev. On Render, set these in the dashboard
# or via render.yaml.

# Allowed frontend origins for CORS (comma-separated)
FRONTEND_URL="https://your-frontend.web.app,https://your-domain.com"

# Supabase service credentials (server-side)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Emails
# Opción A (ACTUAL): Brevo SMTP (300 emails/día) — envío principal
# Si SMTP_ENABLED=true, sendMail prioriza SMTP por sobre Resend.
# SMTP_ENABLED=true
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="<tu-login>@smtp-brevo.com"
# SMTP_PASSWORD="<tu key de Brevo>"
# SMTP_FROM="Ciclo Market <avisos@ciclomarket.ar>"
# SMTP_LOGGER=true

# Opción B: Resend API (fallback + audiencias/newsletter vía API directa)
# RESEND_API_KEY="YOUR_RESEND_API_KEY"
# RESEND_AUDIENCE_GENERAL_ID="your-audience-id"
# SMTP_FROM="Ciclo Market <notificaciones@your-domain.com>"
# SMTP_LOGGER=true

# Optional image used in OG when a listing has no image
# SHARE_FALLBACK_IMAGE="https://your-domain.com/og-preview.png"

# Mercado Pago (si aplica)
# MERCADOPAGO_ACCESS_TOKEN="YOUR_MP_ACCESS_TOKEN"

# PostHog server-side (opcional, recomendado para eventos backend)
# POSTHOG_API_KEY="phc_xxxxxxxxxxxxxxxxx"
# POSTHOG_HOST="https://app.posthog.com"

# Suscripciones de tiendas (recurrencia mensual)
# STORE_SUBSCRIPTION_PRICE_CENTS=99900
# STORE_SUBSCRIPTION_CURRENCY=ARS
# STORE_SUBSCRIPTION_TRIAL_DAYS=7
# STORE_SUBSCRIPTION_GRACE_DAYS=7
# PUBLIC_BASE_URL="https://api.your-domain.com"    # para webhooks
# MP_SUBSCRIPTIONS_ENABLED=true

# Recordatorios de reseñas
# REVIEW_REMINDER_ENABLED=true
# REVIEW_REMINDER_CRON="0 10 * * *"  # diario 10:00
# REVIEW_REMINDER_BATCH_LIMIT=500
# REVIEW_REMINDER_TZ="America/Argentina/Buenos_Aires"

# Notion Growth OS Integration
# Nunca exponer en frontend
# NOTION_TOKEN="secret_xxxxxxxxxxxxx"
# NOTION_DB_CONTENT="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# NOTION_DB_INSIGHTS="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# NOTION_DB_TASKS="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# NOTION_SYNC_SECRET="super-secret-for-sync-endpoint"
# NOTION_RETRY_MAX=4
# NOTION_RETRY_BASE_MS=700
